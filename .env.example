# Which model vendor serves the commentary layer. Two are implemented:
#
#   anthropic  the Anthropic API directly
#   bedrock    Amazon Bedrock through its OpenAI-compatible endpoint
#
# The forecast itself never calls a model, so this choice affects the prose
# and nothing about the numbers. Adding a third vendor is one class in
# src/provider.py, not a rewrite of src/commentary.py.
LLM_PROVIDER=anthropic

# Optional. Empty means "the active provider's own default model" — a single
# hardcoded id would name a model only one of the providers can serve.
COMMENTARY_MODEL=

# --- LLM_PROVIDER=anthropic -------------------------------------------------
# Needed only by src/commentary.py and /api/commentary/live.
# Leave empty on a public deployment: preset commentary is served from the
# committed data/commentary.json, and the live endpoint returns 503 rather
# than putting a billable key behind an open button.
ANTHROPIC_API_KEY=

# --- LLM_PROVIDER=bedrock ---------------------------------------------------
# A Bedrock API key from the AWS console, and the OpenAI-compatible endpoint
# for your region — the region is part of the URL, there is no separate
# region variable.
#
# OPENAI_API_KEY / OPENAI_BASE_URL are read as fallbacks, because those are
# the names the console and the `openai` SDK use. Prefer the BEDROCK_ names:
# a variable called OPENAI_API_KEY holding a Bedrock key misleads the next
# person to read the file, and a stray real OpenAI key in the environment
# would silently send the run to a different vendor.
BEDROCK_API_KEY=
BEDROCK_BASE_URL=https://bedrock-mantle.eu-central-1.api.aws/v1

# --- API --------------------------------------------------------------------
# Browser origins allowed to call the API. Defaults to localhost:3000/3001.
# Set to the deployed frontend origin when hosting.
CORS_ORIGINS=

# Optional: overrides the built-in regex that also allows Vercel preview
# deployments of this project. Keep it scoped — an open regex lets any site
# call an API that holds a billable key.
CORS_ORIGIN_REGEX=
